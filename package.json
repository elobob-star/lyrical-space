{
  "name": "portascribe",
  "private": true,
  "version": "0.1.0",
  "description": "PORTASCRIBE MK-I — a hardware-flavoured lyric notepad",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "cmu": "node scripts/build-cmu.mjs",
    "icons": "node scripts/make-icons.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/doto": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "immer": "^10.2.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@preact/preset-vite": "^2.10.6",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "subtlex-word-frequencies": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
